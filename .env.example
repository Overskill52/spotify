# =====================================================================
# Настройки учетных записей Spotify Developer Dashboard
# Создайте приложение на https://developer.spotify.com/dashboard
# =====================================================================

SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# =====================================================================
# ID целевого плейлиста Spotify
# Можно указать ID (например: 37i9dQZF1DXcBWIGoYBM5M)
# или полную ссылку (например: https://open.spotify.com/playlist/37i9dQZF1DXcBWIGoYBM5M?si=...)
# =====================================================================

SPOTIFY_PLAYLIST_ID=your_spotify_playlist_id_here
